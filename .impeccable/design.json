      "description": "Labelled field with emerald focus.",
      "html": "<label class=\"ds-field-label\" for=\"ds-field\">Reference</label><input id=\"ds-field\" class=\"ds-field\" placeholder=\"Shipment reference\" />",
      "css": ".ds-field-label{font-family:var(--font-sans, Instrument Sans, system-ui, sans-serif);display:block;font-size:12px;font-weight:600;color:var(--muted, #53655b);margin-bottom:7px}.ds-field{font-family:var(--font-sans, Instrument Sans, system-ui, sans-serif);width:100%;min-height:42px;padding:9px 10px;border:1px solid var(--line-strong, #cbd6ce);border-radius:12px;background:var(--card, #fff);color:var(--ink, #161d1a);font-size:14px;transition:border-color 150ms,box-shadow 150ms}.ds-field:hover{border-color:#9fb3a7}.ds-field:focus-visible{outline:none;border-color:var(--emerald, #007b52);box-shadow:0 0 0 3px #007b5226}"
    },
    {
      "name": "Primary Navigation",
      "kind": "nav",
      "refersTo": "navigation-pill",
      "description": "Pill navigation with graphite current state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary navigation\"><a class=\"ds-pill ds-active\" href=\"#\" aria-current=\"page\">Dashboard</a><a class=\"ds-pill\" href=\"#\">Workspaces</a></nav>",
      "css": ".ds-nav{display:flex;gap:7px}.ds-pill{font-family:var(--font-sans, Instrument Sans, system-ui, sans-serif);display:inline-flex;padding:11px 16px;border-radius:999px;background:var(--card, #fff);color:var(--body, #3f4f47);font-size:12px;font-weight:650;text-decoration:none}.ds-pill:hover{background:var(--soft, #edf2ee)}.ds-pill.ds-active{background:var(--graphite, #161d1a);color:#fff}.ds-pill:focus-visible{outline:3px solid var(--focus, #1fa06b);outline-offset:2px;}"
    },
    {
      "name": "Status Chip",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Compact semantic status capsule.",
      "html": "<span class=\"ds-chip\">Open</span>",
      "css": ".ds-chip{font-family:var(--font-sans, Instrument Sans, system-ui, sans-serif);display:inline-flex;padding:3px 9px;border-radius:999px;background:#dcf1e6;color:#025e3d;font-size:10.5px;font-weight:600}"
    },
    {
      "name": "Workspace Card",
      "kind": "card",
      "refersTo": "workspace-card",
      "description": "Lifted workspace entry with full feature destination.",
      "html": "<a class=\"ds-workspace\" href=\"#\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg><h2>Operations</h2><p>Jobs<br>Shipments<br>Documents</p><span>Open workspace \u2197</span></a>",
      "css": ".ds-workspace{font-family:var(--font-sans, Instrument Sans, system-ui, sans-serif);display:block;min-height:230px;padding:24px;border-radius:16px;background:#edf5f0;color:var(--ink, #161d1a);text-decoration:none;box-shadow:var(--surface-raised, 0 8px 24px -14px #173d2926);transition:background 180ms,box-shadow 180ms}.ds-workspace svg{color:var(--emerald, #007b52);margin-bottom:26px}.ds-workspace h2{font-family:var(--font-display, Plus Jakarta Sans, sans-serif);font-size:23px;font-weight:650;margin:0 0 12px}.ds-workspace p{font-size:12px;line-height:1.45;color:var(--muted, #53655b)}.ds-workspace span{font-size:12px;font-weight:700;color:var(--emerald, #007b52)}.ds-workspace:hover{background:var(--hover, #f0f5f1);box-shadow:var(--surface-floating, 0 20px 48px -24px #173d2940)}.ds-workspace:focus-visible{outline:3px solid var(--focus, #1fa06b);outline-offset:2px;}"
    },
    {
      "name": "Cash Account Card",
      "kind": "custom",
      "refersTo": "cash-card",
      "description": "Deep green account surface; preview uses a value placeholder.",
      "html": "<section class=\"ds-cash\"><header>Cash &amp; bank</header><strong>\u2014 <small>AED</small></strong><footer>Elvora Shipping L.L.C. <a href=\"#\">Accounts \u2197</a></footer></section>",
      "css": ".ds-cash{font-family:var(--font-sans, Instrument Sans, system-ui, sans-serif);padding:24px;border-radius:16px;background:#025e3d;color:#fff;box-shadow:0 15px 28px -19px #025e3d80}.ds-cash header,.ds-cash footer{font-size:12px;color:#d3eee0}.ds-cash strong{display:block;font-family:var(--font-display, Plus Jakarta Sans, sans-serif);font-size:38px;letter-spacing:-.03em;margin:22px 0 24px}.ds-cash small{font-size:14px;font-weight:400}.ds-cash footer{display:flex;justify-content:space-between;gap:12px;font-size:11px}.ds-cash a{color:#fff;text-decoration:none}.ds-cash a:hover{text-decoration:underline}.ds-cash a:focus-visible{outline:3px solid var(--focus, #1fa06b);outline-offset:2px;}"
    }
  ],
  "narrative": {
    "northStar": "The Calm Operating Wallet",
    "overview": "Elvora translates the supplied wallet reference into a calm operating workspace for the owner and operations team. Quiet pill navigation, a narrow icon rail and floating rounded surfaces create clear access to financial context and shipment work. Emerald, graphite and warm neutral tints retain the existing Elvora brand.\n\nThe same surface language spans workspaces, dashboards, records, forms, dialogs and sign-in. Repository logos, icon marks and self-hosted fonts remain the only brand assets. The reference supplies composition; real API data and permission-filtered operational workflows supply the content.",
    "keyCharacteristics": [
      "Capsule navigation and circular shortcuts.",
      "Light neutral canvas, white floating surfaces and restrained brand tints.",
      "Readable operating tables and wrapping labels.",
      "Equal access to owner figures and operational actions."
    ],
    "rules": [
      {
        "name": "The Brand Continuity Rule",
        "body": "Translate the reference composition using Elvora's existing identity assets and palette.",
        "section": "colors"
      },
      {
        "name": "The Surface Lift Rule",
        "body": "Reserve diffuse lift for surfaces and state; keep the surrounding application canvas quiet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the supplied Elvora assets, fonts and brand palette.",
      "Do derive navigation and displayed figures from permitted metadata and actual API data.",
      "Do keep table scrolling inside its surface and labels able to wrap.",
      "Do keep keyboard focus visible and respect reduced motion.",
      "Do preserve existing routes, task actions, demo isolation and print document content."
    ],
    "donts": [
      "Don't substitute reference branding, stock imagery or invented financial figures.",
      "Don't hide permitted tasks behind workspace previews.",
      "Don't turn the narrow shortcut rail into a competing full module sidebar.",
      "Don't clip operational fields or hide modal actions inside scrolling field content.",
      "Don't redraw the verified favicon mark; retain exports from public/brand/icon-primary.png."
    ]
  }
}
