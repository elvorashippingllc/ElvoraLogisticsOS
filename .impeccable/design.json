  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Existing operating button variant.",
      "html": "<button class=\"ds-button-primary\">Save changes</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:7px 14px;border-radius:10px;font:600 13.5px/1.35 var(--font-sans);cursor:pointer;transition:background 180ms,transform 180ms var(--ease);background:var(--emerald);color:#fff;border:1px solid transparent;}.ds-button-primary:hover:not(:disabled){filter:brightness(.93);}.ds-button-primary:active:not(:disabled){transform:translateY(1px);}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed;}.ds-button-primary:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Existing operating button variant.",
      "html": "<button class=\"ds-button-outline\">Save changes</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:7px 14px;border-radius:10px;font:600 13.5px/1.35 var(--font-sans);cursor:pointer;transition:background 180ms,transform 180ms var(--ease);background:var(--card);color:var(--ink);border:1px solid var(--line-strong);}.ds-button-outline:hover:not(:disabled){background:var(--hover);}.ds-button-outline:active:not(:disabled){transform:translateY(1px);}.ds-button-outline:disabled{opacity:.5;cursor:not-allowed;}.ds-button-outline:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Existing operating button variant.",
      "html": "<button class=\"ds-button-ghost\">Save changes</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:7px 14px;border-radius:10px;font:600 13.5px/1.35 var(--font-sans);cursor:pointer;transition:background 180ms,transform 180ms var(--ease);background:transparent;color:var(--body);border:1px solid transparent;}.ds-button-ghost:hover:not(:disabled){background:var(--hover);}.ds-button-ghost:active:not(:disabled){transform:translateY(1px);}.ds-button-ghost:disabled{opacity:.5;cursor:not-allowed;}.ds-button-ghost:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled record field.",
      "html": "<label class=\"ds-label\" for=\"ds-field\">Reference</label><input id=\"ds-field\" class=\"ds-input\" placeholder=\"Reference\">",
      "css": ".ds-label{display:block;font:600 12px var(--font-sans);color:var(--muted);margin-bottom:4px;letter-spacing:.01em}.ds-input{width:100%;min-height:40px;padding:6px 10px;border-radius:10px;border:1px solid var(--line-strong);background:var(--card);color:var(--ink);font:14px var(--font-sans);transition:border-color .15s,box-shadow .15s}.ds-input:hover{border-color:#9fb3a7}.ds-input:focus{outline:none;border-color:var(--emerald);box-shadow:0 0 0 3px #007b5226}"
    },
    {
      "name": "Workspace Card",
      "kind": "card",
      "refersTo": "workspace-card",
      "description": "Metadata group entry with previews and complete feature count.",
      "html": "<a class=\"ds-workspace\" href=\"#workspace\"><h2>Workspace</h2><span>Feature preview</span><strong>Open workspace</strong></a>",
      "css": ".ds-workspace{display:flex;flex-direction:column;gap:24px;min-height:290px;padding:24px;border-radius:16px;background:var(--card);color:var(--ink);text-decoration:none;box-shadow:0 10px 28px -22px #193b2b60;transition:background 180ms var(--ease),box-shadow 180ms var(--ease)}.ds-workspace h2{font:700 24px/1.2 var(--font-display);letter-spacing:-.025em;overflow-wrap:anywhere;margin:0}.ds-workspace span{font:13px var(--font-sans);color:var(--muted)}.ds-workspace strong{margin-top:auto;color:var(--emerald);font:700 12px var(--font-sans)}.ds-workspace:hover{background:var(--hover);box-shadow:0 16px 30px -22px #193b2b80}.ds-workspace:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Feature Card",
      "kind": "card",
      "refersTo": "feature-card",
      "description": "Direct link to an existing permitted task route.",
      "html": "<a class=\"ds-feature\" href=\"#feature\"><strong>Feature</strong><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-feature{display:flex;align-items:center;gap:16px;min-height:104px;padding:22px;border-radius:16px;background:var(--card);color:var(--ink);text-decoration:none;font:15px var(--font-sans);box-shadow:0 10px 28px -22px #193b2b50;transition:background 180ms var(--ease)}.ds-feature strong{flex:1;min-width:0;overflow-wrap:anywhere;line-height:1.45}.ds-feature svg{color:var(--emerald);flex:none}.ds-feature:hover{background:var(--hover)}.ds-feature:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}"
    },
    {
      "name": "Breadcrumb",
      "kind": "nav",
