      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared capsule action control.",
      "html": "<button class=\"ds-button-primary\">Save changes</button>",
      "css": ".ds-button-primary{font-family:var(--font-sans, Instrument Sans, system-ui, sans-serif);display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:9px 17px;border-radius:999px;border:1px solid transparent;background:var(--emerald, #007b52);color:#fff;font-size:12.5px;font-weight:600;cursor:pointer;transition:background 180ms,box-shadow 180ms,transform 180ms var(--ease,cubic-bezier(.16,1,.3,1));} .ds-button-primary:hover{filter:brightness(.93);box-shadow:0 5px 12px -6px #102d2060;} .ds-button-primary:active{transform:translateY(1px);} .ds-button-primary:focus-visible{outline:3px solid var(--focus, #1fa06b);outline-offset:2px;}"
    },
