NODE_ENV=production
PORT=8080
DATA_DIR=./data
# Database. Leave DATABASE_URL empty to use the local SQLite file in DATA_DIR. Set it to run on PostgreSQL (e.g. Supabase):
#   use the *session pooler* or direct connection string, NOT the transaction pooler (port 6543).
# Never commit this value; set it as a secret on the host. See docs/POSTGRES.md.
DATABASE_URL=
# PostgreSQL schema for production data (the demo workspace uses <schema>_demo)
PG_SCHEMA=elvora
# Public URL (used in e-mails and tracking links)
PUBLIC_URL=https://os.example.com
# Set true when running behind a reverse proxy (nginx, Caddy, Traefik)
TRUST_PROXY=true
COOKIE_SECURE=true
APP_TIMEZONE=Asia/Dubai
BASE_CURRENCY=AED
# Key that encrypts API keys / tokens saved in Integrations (AES-256-GCM). If unset, a key file is created in the data folder.
# Set it explicitly in production and keep it OUT of backups: APP_SECRET=<long random string>
APP_SECRET=
# First-run accounts. CHANGE THESE before first start, or change the passwords after first login.
ADMIN_EMAIL=admin@elvorashipping.com
ADMIN_PASSWORD=Elvora@Admin2026
MANAGER_EMAIL=manager@elvorashipping.com
MANAGER_PASSWORD=Elvora@Manager2026
# Optional outgoing mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
# Isolated demo workspace (separate database file, fictional data, no outbound traffic).
# Set DEMO_ENABLED=false to remove the demo account and the "Explore the demo workspace" button.
DEMO_ENABLED=true
DEMO_EMAIL=demo@elvorashipping.com
DEMO_PASSWORD=Demo@Elvora2026

# Optional: Chromium path for server-side PDF (the Docker image sets this)
CHROME_PATH=
