{
  "name": "elvora-logistics-os",
  "version": "1.0.0",
  "private": true,
  "description": "Elvora Logistics OS \u2014 freight forwarding, CRM, jobs, accounts, warehouse and transport ERP for Elvora Shipping LLC",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/index.mjs --packages=external --sourcemap",
    "start": "node --env-file-if-exists=.env dist/server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --env-file-if-exists=.env tests/smoke.ts",
    "test:integrations": "tsx --env-file-if-exists=.env tests/phase2.ts",
    "docs:build": "node tools/docs/build.mjs && node tools/docs/build-all.mjs && node tools/docs/readme.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "nodemailer": "^7.0.10",
    "playwright-core": "^1.63.0",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-query": "^5.90.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@vitejs/plugin-react": "^5.1.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "docx": "^9.9.0",
    "esbuild": "^0.25.11",
    "lucide-react": "^0.552.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.3.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}